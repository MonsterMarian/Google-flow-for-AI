{
  "manifest_version": 3,
  "name": "FlowBridge",
  "version": "0.4.0",
  "minimum_chrome_version": "111",
  "description": "Fronta promptů pro Google Flow - dávkuje generování a stahuje výsledky.",
  "permissions": [
    "storage",
    "downloads",
    "scripting",
    "debugger",
    "unlimitedStorage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://labs.google/*",
    "https://flow.google.com/*",
    "https://*.googleusercontent.com/*",
    "https://storage.googleapis.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://labs.google/fx/tools/flow*",
        "https://flow.google.com/*"
      ],
      "js": [
        "inject.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://labs.google/fx/tools/flow*",
        "https://flow.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "panel.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "FlowBridge - otevře panel ve Flow"
  }
}
